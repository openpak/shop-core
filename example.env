# shop-core (block 20240 in ports.md). Copy to .env, fill in, never commit .env.
SHOP_CORE_DATABASE_URL=postgres://postgres:test@127.0.0.1:54340/shop_core?sslmode=disable
SHOP_CORE_HTTP_ADDR=127.0.0.1:20240
# What tools (the packaging runner, Pakka, the website) present as X-Internal-Key. Unset: every route is 503.
SHOP_CORE_INTERNAL_KEY=
# Read-only mirror of the Switch catalog: nx-shop's store admin API (GET only) and its internal key.
# Unset: the Switch catalog is not mirrored.
# SHOP_CORE_NX_API_BASE=http://openpak-nx-shop:20070
# SHOP_CORE_NX_KEY=
# SHOP_CORE_IMPORT_INTERVAL=15m
